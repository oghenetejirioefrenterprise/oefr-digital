# === Secrets & live sessions (NEVER commit) ===
.env
.env.local
.env.*.local
.env.*
!.env.example
*session*.json
x-session*.json
state/browser_cookies/
**/cookies*.json

# === Trinity runtime state (kept locally) — except versioned employee identities ===
.trinity/
!.trinity/employees/
!.trinity/employees/**

# === Datasets, products & customer/operational state (large / regenerable / PII) ===
state/customers/
state/subscription-refresh-log/

# Bulk data artifacts — raw, intermediate, and delivered datasets. These are
# large, regenerable, often contain personal contact PII, and are delivered to
# buyers via external hosting (GitHub Releases / Gumroad), NOT from this repo.
# Covers every naming variant (raw-*, raw_*, *_raw, *.cleaned, top-level, etc).
*.csv
*.xls
*.xlsx
*.zip
# Raw harvest dumps (any format, incl. multi-MB .txt corporation/inspection files)
state/datasets/raw_*/
state/datasets/*/raw-*
state/datasets/*/clean-*

# === Browser-automation artifacts (captchas, screenshots, traces, console logs) ===
*.png
.playwright-mcp/

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# === Node / Next.js (site/) ===
node_modules/
.next/
*.tsbuildinfo

# === Build / deploy ===
dist/
build/
.vercel
.vercel/

# === Logs & runtime ===
*.log
*.pid
*.db

# === OS / editor cruft ===
.DS_Store
Thumbs.db
=*
.archive_cleanup/
