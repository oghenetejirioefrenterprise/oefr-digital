# DataStructured secrets — copy to .env (gitignored) and fill in.
#
# NOTE: Stripe (STRIPE_SECRET, STRIPE_PUBLISHABLE_KEY) and Gumroad
# (GUMROAD_USERNAME, GUMROAD_PASSWORD) are inherited from the shell
# (set in ~/.profile, auto-loaded by .bashrc). Don't duplicate them here.

# Telegram bot — new bot for DataStructured, created via @BotFather (Milestone 8)
TELEGRAM_BOT_TOKEN=

# Founder Telegram numeric user ID — DM @userinfobot to look it up
FOUNDER_TELEGRAM_USER_ID=
