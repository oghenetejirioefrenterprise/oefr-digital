{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DistributionLog",
  "description": "Tracks what has been posted to which social channels and when.",
  "type": "object",
  "required": ["version", "type", "updated_at", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer" },
    "type": { "type": "string", "const": "distribution_log" },
    "updated_at": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "slug", "channel", "posted_at", "status"],
        "additionalProperties": false,
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "minLength": 1 },
          "channel": {
            "type": "string",
            "description": "e.g. 'twitter', 'reddit:r/trucking', 'reddit:r/Entrepreneur'"
          },
          "posted_at": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["posted", "failed", "skipped"]
          },
          "url": { "type": "string" },
          "content": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
