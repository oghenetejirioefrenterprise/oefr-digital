# ── Trinity Agent Configuration ──────────────────────────────────
# Copy this file to `trinity.toml` in your workspace root and edit.
# All sections are optional — sensible defaults are used when omitted.

# ── Company ─────────────────────────────────────────────────────
[company]
name = "My Company"
description = "A brief description of what your company does."
default_employee = "assistant"  # Which employee responds by default

# ── Authentication ──────────────────────────────────────────────
[auth]
provider = "anthropic_api"        # "anthropic_api" or "openai_api"
api_key_env = "ANTHROPIC_API_KEY" # Name of env var holding the API key
# base_url = ""                   # Custom base URL (for proxies/local models)

# ── Agent Defaults ──────────────────────────────────────────────
[agent]
max_turns = 30              # Max tool-use turns per conversation
max_tokens = 16384          # Max tokens per response
action_timeout = 3600       # Seconds before an action agent times out
convo_timeout = 120         # Seconds before a conversational turn times out
default_model = "claude-sonnet-4-6"
router_model = "claude-haiku-4-5-20251001"  # Fast model for routing decisions
action_model = "claude-sonnet-4-6"          # Model for executing actions
judge_model = "claude-opus-4-6"             # Model for evaluation/judgment

# ── Telegram ────────────────────────────────────────────────────
[telegram]
bot_token_env = "TELEGRAM_BOT_TOKEN"  # Env var holding the bot token
poll_timeout = 30                      # Long-poll timeout in seconds
max_response_length = 4000             # Truncate responses beyond this
streaming_update_interval = 8          # Seconds between streaming edits

[telegram.acl]
dm_policy = "allowlist"       # "allowlist" or "open"
allowed_users = []            # Telegram user IDs (integers)
group_policy = "allowlist"    # "allowlist" or "open"

# Define Telegram group configurations:
# [telegram.groups.my_group]
# chat_id = "-100123456789"
# employee = "cmo"            # Which employee responds in this group
# focus = "marketing"         # Context hint for the agent
# tone = "professional"       # Tone hint
# require_mention = false     # If true, only responds when @mentioned

# ── Memory ──────────────────────────────────────────────────────
[memory]
short_term_decay_hours = 48   # Short-term memories fade after this
long_term_decay_days = 30     # Long-term memories decay after this
max_short_term = 200          # Max short-term memory entries
max_long_term = 500           # Max long-term memory entries
chat_history_buffer = 10      # Number of recent messages kept in context
promotion_threshold = 0.8     # Score threshold to promote short -> long term
correction_weight = 2.0       # Weight multiplier for correction memories

# ── Scheduler ───────────────────────────────────────────────────
[scheduler]
enabled = true

# Define scheduled cycles:
# [scheduler.cycles.morning_report]
# schedule = "0 9 * * 1-5"      # Cron expression: 9 AM weekdays
# employee = "ceo"               # Which employee runs this cycle
# report_to = "blockers"         # Telegram group to send results to
# type = "needle"                # Cycle type: needle, audit, research, etc.
# task = "Find and execute the single highest-impact action"

# [scheduler.cycles.content_publish]
# schedule = "0 8 * * *"         # 8 AM daily
# employee = "seo_operator"
# report_to = "marketing"
# type = "seo"
# task = "Publish the next scheduled SEO article"

# ── Employees ───────────────────────────────────────────────────
# Register employees here. Their identity files live in .trinity/employees/<name>/identity.md
# Use `trinity employee create <name> --title <Title>` to generate both the config entry and identity file.

# [employees.trinity]
# title = "CEO"
# model = ""                     # Override model for this employee (blank = use agent.default_model)

# [employees.morpheus]
# title = "CMO"
# model = ""

# [employees.oracle]
# title = "Research IC"
# model = ""

# ── Workspace ───────────────────────────────────────────────────
[workspace]
products_dir = "."              # Root directory for product discovery
exclude_patterns = [
    "node_modules",
    ".git",
    "__pycache__",
    ".next",
    "dist",
    "build",
]
